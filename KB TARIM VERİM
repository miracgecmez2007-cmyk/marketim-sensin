{icon:"wind",badge:"Aşama 2",title:"Yapraktan Uygulama",text:"Gelişim ve stres dönemlerinde yaprak yüzeyinden besleme.",checks:["4-6 yapraklı dönemde başlayın.","Ürünü etiket önerisine göre tanka ekleyin.","Rüzgârlı ve çok sıcak havada uygulamayın."],tip:"Karıştırmadan önce etiketi okuyun ve küçük çaplı uyumluluk denemesi yapın."},
{icon:"waves",badge:"Aşama 3",title:"Damla Sulama ile Uygulama",text:"Sera ve damlama hatlarında kök bölgesine aktarım.",checks:["Sulamanın son bölümünde enjeksiyonu açın.","KB Nitro-Boost'u etiket aralığında tekrarlayın.","Sonrasında hatları temiz suyla durulayın."],tip:"Hat tıkanıklığını önlemek için durulamayı atlamayın."}];
const FAQS=[
["KB ürünleri kimyasal gübrelerle birlikte kullanılabilir mi?","Bu ürüne ve gübre cinsine göre değişir. Karışım yapmadan önce ürün etiketini okuyun, küçük çaplı deneme yapın veya ekibimize danışın."],
["Saklama koşulları nelerdir?","Doğrudan güneş ışığından uzak, serin bir ortamda ve orijinal ambalajında saklayın. Raf ömrü ve sıcaklık aralığı için ürün etiketine bakın."],
["Damla sulama sistemlerinde kullanılabilir mi?","Damla sulama uygulaması için ürüne özel etiket talimatına uyun. Uygulama sonrası hatları durulamanız önerilir."],
["Etkiyi ne kadar sürede görürüm?","Süre ürüne, toprağa, iklime ve ürün cinsine göre değişir. Beklentinizi ekibimizle paylaşın, size uygun takip planı önerelim."]];

// ===== SİMÜLATÖR =====
let chart=null,sim={dose:1.5,y:0};
const PRESETS=[["Kurak ve Zayıf Toprak",30,20,2],["Standart Tarla",60,50,1.5],["İyi Bakımlı Sera",80,80,1]];

function initChart(){
  if(!window.Chart || !$("yieldChart")) return;
  const ctx=$("yieldChart").getContext("2d");
  if(chart) chart.destroy();
  const g=ctx.createLinearGradient(0,0,0,280);
  g.addColorStop(0,"rgba(163,230,53,.5)");g.addColorStop(1,"rgba(163,230,53,0)");
  chart=new Chart(ctx,{type:"line",data:{labels:["Ekim","Filiz","Gelişim","Çiçeklenme","Hasat"],datasets:[
    {label:"KB ile (tahmini)",data:[],borderColor:"#a3e635",backgroundColor:g,borderWidth:3,fill:true,tension:.35},
    {label:"Mevcut yöntem",data:[100,102,104,106,108],borderColor:"#64748b",borderDash:[5,5],pointRadius:0,tension:.2}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:"#cbd5e1"}}},scales:{x:{ticks:{color:"#94a3b8"},grid:{color:"rgba(255,255,255,.05)"}},y:{ticks:{color:"#94a3b8",callback:v=>"%"+v},grid:{color:"rgba(255,255,255,.05)"}}}}});
}
function updateSim(){
  if(!$("soil") || !$("irr") || !$("dose")) return;
  const soil=+$("soil").value,irr=+$("irr").value,dose=+$("dose").value;
  if($("soilVal")) $("soilVal").textContent=(soil<40?"Zayıf":soil<75?"Orta":"Çok İyi")+` (%${soil})`;
  if($("irrVal")) $("irrVal").textContent=(irr<40?"Kısıtlı":irr<75?"Orta":"Yüksek")+` (%${irr})`;
  if($("doseVal")) $("doseVal").textContent=dose.toFixed(1)+" L/Dönüm";
  const y=Math.min(40,Math.round(dose*9*(1+(100-soil)/150)*(.7+irr/200)));
  if($("mYield")) $("mYield").textContent="+%"+y;
  if($("mHealth")) $("mHealth").textContent=Math.min(99,Math.round(soil*.5+dose*12+irr*.15))+"/100";
  if($("mWater")) $("mWater").textContent="+%"+Math.round(dose*6*(1+(100-soil)/200));
  sim={dose,y};
  if(chart){const s=y/4;chart.data.datasets[0].data=[100,Math.round(100+s*.8),Math.round(100+s*1.8),Math.round(100+s*2.8),100+y];chart.update("none")}
  calcROI();
}

// ===== ÜRÜN SEÇİCİ =====
function pick(){
  if(!$("pProb") || !$("pStage") || !$("pOut")) return;
  const pr=+$("pProb").value,st=+$("pStage").value,p=PRODUCTS[pr];
  $("pOut").innerHTML=`<b class="text-kb-accent text-base">${p.name}</b> (${p.dose})<br>${p.text}<br><span class="text-slate-400">Siz ${STAGES[st]} kullanmayı planlıyorsunuz.${pr===st?" Bu ürün seçtiğiniz zamana uygun.":" Uygulama zamanı için ürün etiketine ve aşağıdaki rehbere bakın."}</span>`;
}

// ===== ROI =====
const FIELDS=[["roiArea","Arazi (Dönüm)",50,1,100000],["roiCost","Gübre Gideri (₺/Dönüm)",1200,0,1e6],["roiIncome","Sezonluk Gelir (₺/Dönüm)",4000,0,1e7],["roiGain","Beklenen Verim Artışı (%)",8,0,50],["roiSave","Beklenen Gübre Tasarrufu (%)",15,0,60]];
let roi={};
const num=f=>Math.min(f[4],Math.max(f[3],parseFloat($(f[0])?.value)||0));
function calcROI(){
  if(!$("roiArea")) return;
  const v={};FIELDS.forEach(f=>v[f[0]]=num(f));
  const lit=v.roiArea*sim.dose,kb=lit*KB_PRICE_PER_L;
  const savings=v.roiArea*v.roiCost*v.roiSave/100,extra=v.roiArea*v.roiIncome*v.roiGain/100,net=savings+extra-kb;
  roi={area:v.roiArea,savings,extra,kb,net,lit,pct:kb?Math.round(net/kb*100):null};
  if($("rSave")) $("rSave").textContent=tl(savings);
  if($("rExtra")) $("rExtra").textContent=tl(extra);
  if($("rKb")) $("rKb").textContent=tl(kb);
  if($("rLit")) $("rLit").textContent=Math.round(lit).toLocaleString("tr-TR")+" L";
  if($("rNet")) $("rNet").textContent=tl(net);
  if($("rRoi")) $("rRoi").textContent="ROI: "+(roi.pct===null?"—":"%"+roi.pct);
  try{localStorage.setItem("kb-roi",JSON.stringify({...v,crop:$("roiCrop")?.value}))}catch(e){}
}

// ===== MODAL VE OLAYLAR =====
let lastFocus=null;
const openEl=()=>document.querySelector(".modal.flex");
function openModal(id){lastFocus=document.activeElement;const m=$(id);if(!m)return;m.classList.remove("hidden");m.classList.add("flex");(m.querySelector("input,select")||m.querySelector("button"))?.focus()}
function closeModals(){const was=openEl();document.querySelectorAll(".modal").forEach(m=>{m.classList.add("hidden");m.classList.remove("flex")});if(was&&lastFocus)lastFocus.focus()}

document.addEventListener("click",e=>{
  if(e.target.classList&&e.target.classList.contains("modal"))return closeModals();
  const t=e.target.closest("[data-open],[data-close],[data-product],[data-faq],[data-pre]");
  if(!t)return;const d=t.dataset;
  if(d.open){$("mobileMenu")?.classList.add("hidden");$("menuBtn")?.setAttribute("aria-expanded","false");openModal(d.open)}
  else if(d.close!==undefined)closeModals();
  else if(d.product){const p=PRODUCTS[d.product];if(p){$("mTitle").textContent=p.name;$("mDesc").textContent=p.desc;openModal("product-modal")}}
  else if(d.faq){const a=$("fa"+d.faq);if(a){const o=a.classList.toggle("hidden");t.setAttribute("aria-expanded",String(!o));if($("fi"+d.faq)) $("fi"+d.faq).style.transform=o?"":"rotate(180deg)"}}
  else if(d.pre){const p=PRESETS[d.pre];if(p && $("soil")){ $("soil").value=p[1];$("irr").value=p[2];$("dose").value=p[3];updateSim(); }}
});

document.addEventListener("keydown",e=>{
  const m=openEl();if(!m)return;
  if(e.key==="Escape")return closeModals();
});

document.addEventListener("DOMContentLoaded", () => {
  const menuBtn = $("menuBtn");
  const mobileMenu = $("mobileMenu");
  if(menuBtn && mobileMenu) {
    menuBtn.onclick = () => { const h = mobileMenu.classList.toggle("hidden"); menuBtn.setAttribute("aria-expanded", String(!h)); };
    mobileMenu.addEventListener("click", e => { if (e.target.closest("a")) { mobileMenu.classList.add("hidden"); menuBtn.setAttribute("aria-expanded", "false"); } });
  }
});

// WhatsApp teklifi
document.addEventListener("submit",e=>{
  if(e.target && e.target.id === "quoteForm") {
    e.preventDefault();
    const name=$("qName")?.value.trim()||"",phone=$("qPhone")?.value.trim()||"",city=$("qCity")?.value.trim()||"",err=$("qError");
    const bad=name.length<2?"Lütfen ad soyadınızı girin.":phone.replace(/\D/g,"").length<10?"Lütfen geçerli bir telefon numarası girin.":"";
    if(err){ err.textContent=bad; err.classList.toggle("hidden",!bad); }
    if(bad)return;
    const msg=`Merhaba KB AgTech Ekibi, teklif talebinde bulunuyorum.\n\n*Ad Soyad:* ${name}\n*Telefon:* ${phone}\n*Şehir/İlçe:* ${city||"-"}\n*Arazi:* ${roi.area||50} Dönüm\n*Tahmini KB ihtiyacı:* ${Math.round(roi.lit||0)} L\n*Tahmini gübre tasarrufu:* ${tl(roi.savings||0)}\n*Tahmini net kazanç:* ${tl(roi.net||0)} / Sezon\n\nÜrün teklifi ve fiyat detaylarını görüşmek istiyorum.`;
    const url="https://wa.me/"+WHATSAPP_NUMBER+"?text="+encodeURIComponent(msg);
    const w=window.open(url,"_blank");
    if(!w){if(err){err.innerHTML=`Açılır pencere engellendi. <a class="underline" href="${esc(url)}" target="_blank" rel="noopener">WhatsApp'ı buradan açın</a>.`;err.classList.remove("hidden");}return}
    w.opener=null;closeModals();
  }
});

// Yazdır
document.addEventListener("click", e => {
  if(e.target && e.target.id === "printBtn") {
    if($("pDate")) $("pDate").textContent=new Date().toLocaleDateString("tr-TR");
    const rows=[["Arazi", (roi.area||50)+" Dönüm"],["Tahmini KB ihtiyacı", Math.round(roi.lit||0)+" L"],["Gübre Tasarrufu", tl(roi.savings||0)],["Ek Rekolte Geliri", tl(roi.extra||0)],["KB Ürün Maliyeti", tl(roi.kb||0)],["Net Kazanç", tl(roi.net||0)+" / Sezon"],["ROI", roi.pct===null?"—":"%"+roi.pct]];
    if($("pTable")) $("pTable").innerHTML=rows.map(r=>`<tr><td>${r[0]}</td><td><b>${r[1]}</b></td></tr>`).join("");
    window.print();
  }
});
</script>
